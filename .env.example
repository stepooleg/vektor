# =============================================================================
# Vektor — пример переменных окружения
# =============================================================================
# СКОПИРУЙТЕ в .env и заполните реальными значениями.
# ФАЙЛ .env НИКОГДА НЕ КОММИТИТСЯ (он в .gitignore).
# В этом файле — ТОЛЬКО примеры и дефолты для локальной разработки.
# =============================================================================

# ---------- Django ----------
DJANGO_SETTINGS_MODULE=vektor.settings
SECRET_KEY=change-me-to-a-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Фронт-домен для CORS (on-premise — обычно внутренний)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- База данных (PostgreSQL 16) ----------
POSTGRES_DB=vektor
POSTGRES_USER=vektor
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_SSLMODE=prefer

# ---------- Redis / Celery ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- Аутентификация (SPEC §10.2) ----------
# SSO через AD/LDAP (тип уточняется, SPEC §17 п.2)
AUTH_LDAP_ENABLED=False
AUTH_LDAP_SERVER_URI=ldap://dc.example.local
AUTH_LDAP_BIND_DN=
AUTH_LDAP_BIND_PASSWORD=
AUTH_LDAP_USER_SEARCH_BASE=
# Локальный вход паролём — запасной механизм
LOCAL_LOGIN_ENABLED=True

# ---------- Email (SMTP) (SPEC §10.3) ----------
EMAIL_HOST=smtp.example.local
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Vektor <no-reply@example.local>

# ---------- Web Push (PWA) (SPEC §10.4) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@example.local

# ---------- Интеграция с 1С:ЗУП (SPEC §10.1) ----------
ONEC_SYNC_ENABLED=False
ONEC_BASE_URL=http://1c-zup.example.local
ONEC_USERNAME=
ONEC_PASSWORD=
# Nightly в 02:00 + ручной запуск
ONEC_SYNC_CRON=0 2 * * *

# ---------- Безопасность / комплаенс ----------
DATA_RETENTION_MONTHS=60   # срок хранения данных оценок (уточняется, SPEC §17 п.3)
AUDIT_LOG_RETENTION_MONTHS=72

# ---------- Frontend (доступен бандлу через VITE_*) ----------
VITE_API_BASE_URL=/api/v1
VITE_SENTRY_DSN=
