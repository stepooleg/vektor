# =============================================================================
# Vektor — пример переменных окружения
# =============================================================================
# СКОПИРУЙТЕ в .env и заполните реальными значениями.
# ФАЙЛ .env НИКОГДА НЕ КОММИТИТСЯ (он в .gitignore).
# В этом файле — ТОЛЬКО примеры и дефолты для локальной разработки.
# =============================================================================

# ---------- Django ----------
DJANGO_SETTINGS_MODULE=vektor.settings
SECRET_KEY=change-me-to-a-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Фронт-домен для CORS (on-premise — обычно внутренний)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- База данных (PostgreSQL 16) ----------
POSTGRES_DB=vektor
POSTGRES_USER=vektor
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_SSLMODE=prefer

# ---------- Redis / Celery ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- Аутентификация (SPEC §10.2) ----------
# Корпоративный вход через прямой AD/LDAP bind (ADR 0006, SPEC §10.2).
# До выбора клиентской площадки оставьте False: CI использует автономный contract test.
AUTH_LDAP_ENABLED=False
AUTH_LDAP_SERVER_URI=ldaps://dc.example.local
AUTH_LDAP_BIND_DN=
AUTH_LDAP_BIND_PASSWORD=
AUTH_LDAP_USER_SEARCH_BASE=DC=example,DC=local
# Для ldap:// включите StartTLS; для ldaps:// оставьте False
AUTH_LDAP_START_TLS=False
# Необязательный PEM-файл доверенного корпоративного CA внутри backend-контейнера
AUTH_LDAP_CA_CERT_FILE=
# Только для изолированной локальной разработки; в production оставьте False
AUTH_LDAP_ALLOW_INSECURE=False
# JSON allowlist: DN группы AD → стабильный код роли Vektor
AUTH_LDAP_GROUP_ROLE_MAP={"CN=Vektor-Employees,OU=Groups,DC=example,DC=local":"employee"}
# Локальный вход паролём — запасной механизм
LOCAL_LOGIN_ENABLED=True

# ---------- Email (SMTP) (SPEC §10.3) ----------
# Для удалённого SMTP включите ровно один режим: STARTTLS или implicit SSL.
# Пустые USER/PASSWORD допустимы вместе для relay, доверяющего IP приложения.
# Plaintext разрешён только для локального Mailpit/MailHog на loopback.
EMAIL_HOST=smtp.example.local
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Vektor <no-reply@example.local>
EMAIL_TIMEOUT=15

# ---------- Web Push (PWA) (SPEC §10.4) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@example.local

# ---------- Интеграция с 1С:ЗУП (SPEC §10.1) ----------
ONEC_SYNC_ENABLED=False
ONEC_BASE_URL=https://1c-zup.example.local/api
ONEC_AUTH_MODE=basic
ONEC_USERNAME=
ONEC_PASSWORD=
ONEC_OAUTH_TOKEN=
ONEC_TIMEOUT_SECONDS=15
# Nightly в 02:00 + ручной запуск
ONEC_SYNC_CRON=0 2 * * *

# ---------- Безопасность / комплаенс ----------
DATA_RETENTION_YEARS=5
# archive сохраняет только обезличенный read-only агрегат; delete удаляет и его
ASSESSMENT_AGGREGATE_RETENTION_MODE=archive
AUDIT_LOG_RETENTION_MONTHS=72

# ---------- LMS ----------
# Максимальный размер файла практического ответа, байт (10 MiB)
LMS_SUBMISSION_MAX_FILE_SIZE=10485760
LMS_SUBMISSION_ALLOWED_CONTENT_TYPES=application/pdf,text/plain,image/jpeg,image/png,application/vnd.openxmlformats-officedocument.wordprocessingml.document
LMS_SUBMISSION_ALLOWED_EXTENSIONS=.pdf,.txt,.jpg,.jpeg,.png,.docx

# ---------- Frontend (доступен бандлу через VITE_*) ----------
VITE_API_BASE_URL=/api/v1
VITE_SENTRY_DSN=
