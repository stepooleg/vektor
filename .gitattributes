# Единые правила переноса строк: в репозитории всегда LF.
* text=auto eol=lf

# Текстовые типы — явно LF
*.py   text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.sh   text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf
.env*  text eol=lf
Dockerfile* text eol=lf

# Бинарные — без нормализации
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text eol=lf
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
